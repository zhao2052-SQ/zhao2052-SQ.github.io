@article{zhao2026memory,
  selected={true},
  title = {Memory Topology: Learning Who May Read and Write Whose Memory in Multi-Agent Systems},
  author = {Siqi Zhao* and Coauthor Name},
  year = {2026},
  journal = {Under Review},
  abstract = {Multi-agent LLM systems are typically built with either fully shared or fully private memory. We argue that the memory access graph should be separated from the communication graph and learned. We show that deliberately restricting memory access can improve collective accuracy, because it preserves the statistical independence of agent errors that verification and voting implicitly assume.},
  description={Separates the communication graph from the memory read/write graph and learns both, showing that information barriers can improve collective intelligence.},
  keywords={Multi-Agent Systems, Memory, Organizational Learning}
}

@inproceedings{zhao2026orchestration,
  selected={true},
  title = {Beyond Routing: Multi-Agent Orchestration as an Organizational Learning Problem},
  booktitle = {Proceedings of a Top-Tier Machine Learning Conference},
  author = {Siqi Zhao* and Coauthor Name},
  year = {2026},
  abstract = {We reframe agent orchestration from topology selection to a six-dimensional organizational design problem: membership, connectivity, scheduling, message representation, memory sharing, and long-horizon self-restructuring.},
  description={A position paper reframing orchestration as organizational learning rather than topology search.},
  keywords={Multi-Agent Systems, Orchestration, LLM Agents}
}

@article{zhao2026quality,
  selected={true},
  title = {Quality-Diversity Search for Robust Factor Discovery in High-Frequency Micro-Markets},
  author = {Siqi Zhao* and Coauthor Name},
  year = {2026},
  journal = {Under Review},
  abstract = {Single-objective search collapses onto a narrow mode when discovering predictive signals in high-frequency order-book data. We apply MAP-Elites style quality-diversity optimization to maintain a structured archive of diverse, high-performing candidates, and evaluate out-of-sample degradation under strict temporal holdout.},
  description={Applies MAP-Elites quality-diversity search to order-book factor discovery, with leak-guarded out-of-sample evaluation.},
  keywords={Quality-Diversity, MAP-Elites, Evolutionary Computation}
}

@inproceedings{zhao2025agents,
  title = {On the Role of Specialization in Cooperative Agent Populations},
  booktitle = {Workshop on Multi-Agent Systems},
  author = {Siqi Zhao* and Coauthor Name},
  year = {2025},
  abstract = {An ablation study showing that heterogeneous agent roles are not redundant: removing any single specialized role degrades collective performance more than reducing the total agent count.},
  description={Role-ablation study demonstrating that specialized agent roles are individually necessary.},
  keywords={Multi-Agent Systems, Specialization}
}
