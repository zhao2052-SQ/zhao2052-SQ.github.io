@article{sha2026benchscope,
  selected={true},
  title = {BenchScope: How Many Independent Signals Does Your Benchmark Provide?},
  author = {Tommy Sha and Siqi (Stella) Zhao*},
  year = {2026},
  journal = {arXiv preprint arXiv:2603.29357},
  arxiv = {2603.29357},
  url = {https://arxiv.org/abs/2603.29357},
  pdf = {https://arxiv.org/pdf/2603.29357},
  abstract = {AI evaluation suites often report many scores without checking whether those scores carry independent information. We introduce Effective Dimensionality (ED), the participation ratio of a centered benchmark-score spectrum, as a fast, population-conditional upper-bound diagnostic of measurement breadth. Applied at per-instance granularity to 22 benchmarks across 8 domains and more than 8,400 model evaluations, ED reveals substantial redundancy: the six-score Open LLM Leaderboard behaves like roughly two effective measurement axes (ED = 1.7), BBH and MMLU-Pro are near-interchangeable (rho = 0.96, stable across seven subpopulations), and measurement breadth varies more than 20x across current benchmarks. We show that relative ED rankings are stable under matched-dimension controls and that ED can flag redundant suite components, monitor performance-conditional compression, and guide benchmark maintenance.},
  description={Introduces Effective Dimensionality (ED) to measure how many genuinely independent signals a benchmark suite provides, revealing that many widely used suites are far more redundant than their score counts suggest.},
  keywords={Benchmarking, Evaluation, Effective Dimensionality, LLM}
}

@article{zhao2027goant,
  selected={true},
  title = {GoAnt: A Dynamic Multi-Agent System for Diverse and Robust Factor Mining from Market Microstructure Data},
  author = {Siqi (Stella) Zhao*},
  year = {2027},
  journal = {Under Review, AAAI 2027},
  abstract = {Automated alpha factor discovery from market microstructure data faces two coupled failures. Naive predictive objectives reward signals that are unprofitable once slippage and market impact are charged, a failure we call the Execution Trap, while static coordinators keep funding similar regions until the population collapses into near-duplicate programs, a failure we call the Reasoning Trap. We propose GoAnt, an ant-colony-inspired framework that decouples generation, execution-aware evaluation and adaptive dispatch. Three non-communicating Worker Ants write programs to a shared Mental Map that sorts candidates into niches, and a compact Queen Ant reallocates the evaluation budget across them. Each niche keeps the centre of the candidate that founded it, so the Map is dynamic through adaptive cardinality alone and not through any re-charting of its geometry. We evaluate on real A-share microstructure data spanning 2023-2026 in two data categories, price-volume panels and order-book snapshots, against communicative multi-agent baselines and against map-free, frozen-map, re-fitted and moving-centre ablations, with the frozen arm enforced by end-of-run invariants, not by label.},
  description={Automated alpha factor discovery from market microstructure data faces two coupled failures: the Execution Trap, where naive predictive objectives reward signals that are unprofitable once slippage and market impact are charged, and the Reasoning Trap, where static coordinators keep funding similar regions until the population collapses into near-duplicate programs. GoAnt is an ant-colony-inspired framework that decouples generation, execution-aware evaluation and adaptive dispatch: three non-communicating Worker Ants write programs to a shared Mental Map that sorts candidates into niches, and a compact Queen Ant reallocates the evaluation budget across them. Each niche keeps the centre of the candidate that founded it, so the Map is dynamic through adaptive cardinality alone. Evaluated on real A-share microstructure data spanning 2023-2026 across price-volume panels and order-book snapshots, against communicative multi-agent baselines and map-free, frozen-map, re-fitted and moving-centre ablations.},
  keywords={Multi-System Orchestration & Multi-Agent System}
}

@article{sha2027thinkprior,
  selected={true},
  title = {ThinkPrior: Zero-Rollout Warm-Start Priors for Prompt Selection in RLVR},
  author = {TianMing Sha and Skylar Zhai and Siqi (Stella) Zhao},
  year = {2027},
  journal = {Under Review, AAAI 2027},
  abstract = {In reinforcement learning with verifiable rewards (RLVR), a group of rollouts that verifies all correct or all wrong has identically zero group-relative advantage and produces no policy gradient. We call such a group silent; under uniform sampling silent groups consume 39% of a run's rollouts, concentrated in early training. Existing online selectors identify them from reward history alone, so a prompt must first be rolled out at full cost before it can be recognized as silent. We bypass this with a single offline pass: a small off-the-shelf anchor model runs through the prompt pool, scored by the same verifier used in training, and its pass rate gives a per-prompt difficulty prior available at step 0. ThinkPrior initializes a Beta posterior from this prior, selects prompts by expected learnability, and updates the posterior online from real outcomes, changing neither the loss nor the optimizer. On Qwen2.5-Math-7B across sixteen random seeds, ThinkPrior more than halves silent groups in early training and cuts wasted rollouts through step 30 by nearly a fifth, while final accuracy is statistically indistinguishable from the baseline. On this 250-prompt pool a fixed budget makes that a reallocation rather than a net saving, since the run exhausts the pool; composing the prior with an oversampling selector turns it into a net reduction (10.6% fewer rollouts on DAPO). ThinkPrior is, to our knowledge, the first prompt selection method whose difficulty signal is computed entirely off-policy, drawing no rollout from the policy at any checkpoint including its initial one, and hence able to cut silence from the very first batch of training.},
  description={In RLVR, a group of rollouts that verifies all correct or all wrong yields zero group-relative advantage and no policy gradient. These silent groups consume 39% of a run's rollouts under uniform sampling, and existing online selectors can only recognise them after paying full rollout cost. ThinkPrior instead runs a single offline pass in which a small anchor model sweeps the prompt pool under the same verifier used in training, giving a per-prompt difficulty prior available at step 0; a Beta posterior initialised from this prior selects prompts by expected learnability and updates online, changing neither the loss nor the optimizer. On Qwen2.5-Math-7B across sixteen seeds it more than halves early silent groups and cuts wasted rollouts through step 30 by nearly a fifth at statistically indistinguishable final accuracy, and composes with an oversampling selector for a net 10.6% rollout reduction on DAPO.},
  keywords={Reinforcement Learning with Verifiable Rewards, LLM Post-Training}
}
